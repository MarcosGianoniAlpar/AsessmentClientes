# Só nomes. Valores ficam no Infisical, numa pasta por cliente:
#   infisical run --path=/<cliente> -- claude
# Os nomes são os mesmos para todos os clientes; o --path escolhe qual instância.
# Usar sempre um usuário com papel somente leitura na instância do cliente.
SN_INSTANCE_URL=
SN_USER=
SN_PASSWORD=
